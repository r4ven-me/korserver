# Generated by korserver. This file defines only project-owned tables.
table inet {{ filter_table }} {
  # auto-merge: user-provided route lists routinely contain overlapping
  # CIDRs (e.g. 5.28.192.0/18 alongside 5.28.192.0/21) and dnsmasq's
  # nftset= additions can land inside an already-listed interval; without
  # it nft rejects the whole ruleset with "conflicting intervals".
  set split_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if split_v4_elements %}
    elements = { {{ split_v4_elements | join(", ") }} }
{% endif %}
  }

  set split_v6 {
    type ipv6_addr
    flags interval
    auto-merge
  }

  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
{% if config.routing.mode == "split" %}
    ip daddr @split_v4 counter meta mark set {{ config.routing.fwmark }}
    ip6 daddr @split_v6 counter meta mark set {{ config.routing.fwmark }}
{% elif config.routing.mode == "full" %}
    ip saddr {{ config.server.ipv4_network }} counter meta mark set {{ config.routing.fwmark }}
{% endif %}
  }

{% if host_split_traffic %}
  chain output {
    # "route" type: the mark must trigger a fresh route lookup so the
    # packet actually moves to the fwmark policy table.
    type route hook output priority mangle; policy accept;
    # ct direction original: only connections the host itself initiated.
    # Replies to inbound connections (SSH, the panel, a VPN client whose
    # public IP happens to land in a split set) keep their normal route.
    # The VPN subnet itself is exempt: the dnsmasq listen address and the
    # clients' per-session /32 routes live there and must never be pulled
    # into the fwmark table by an overlapping split CIDR.
    ct direction original ip daddr != {{ config.server.ipv4_network }} ip daddr @split_v4 counter meta mark set {{ config.routing.fwmark }}
    ct direction original ip6 daddr @split_v6 counter meta mark set {{ config.routing.fwmark }}
  }
{% endif %}

{% if upstream_killswitch %}
  chain forward {
    type filter hook forward priority filter; policy accept;
    # Marked (full: all client traffic; split: only the listed
    # routes/ips/domains) traffic must leave via the upstream tunnel. If it
    # doesn't -- upstream is down, or the policy route hasn't been
    # installed yet -- drop it instead of letting it leak out unencrypted
    # via the host's own connection.
    meta mark {{ config.routing.fwmark }} oifname != "{{ outbound_interface }}" counter drop
  }
{% endif %}

{% if upstream_killswitch and host_split_traffic %}
  chain postrouting {
    # The host kill-switch must live in postrouting, NOT in an output-hook
    # filter chain: every chain of one hook point shares the same
    # nf_hook_state, so an output chain still sees the pre-reroute oifname
    # (the uplink) even after the route chain re-routed the packet into
    # the tunnel -- it would drop ALL marked host traffic. Postrouting is
    # a fresh hook invocation and sees the final routing decision.
    type filter hook postrouting priority filter; policy accept;
    # Local delivery (a marked destination that is also an address on this
    # host) legitimately leaves via lo, never the tunnel.
    oifname "lo" accept
    meta mark {{ config.routing.fwmark }} oifname != "{{ outbound_interface }}" counter drop
  }
{% endif %}
}

table ip {{ nat_table }} {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
{% if config.routing.mode in ["full", "split"] %}
{% if upstream_killswitch %}
    ip saddr {{ config.server.ipv4_network }} meta mark {{ config.routing.fwmark }} oifname "{{ outbound_interface }}" masquerade
    ip saddr {{ config.server.ipv4_network }} meta mark != {{ config.routing.fwmark }} masquerade
{% elif outbound_interface != "auto" %}
    ip saddr {{ config.server.ipv4_network }} oifname "{{ outbound_interface }}" masquerade
{% else %}
    ip saddr {{ config.server.ipv4_network }} masquerade
{% endif %}
{% if host_split_traffic and outbound_interface != "auto" %}
    # Locally originated packets pick their source address before the
    # fwmark re-route, so host traffic redirected into the tunnel still
    # carries the uplink source and replies would never come back;
    # masquerade rewrites it to the tunnel address. (VPN client traffic
    # is already covered by the saddr rules above.)
    meta mark {{ config.routing.fwmark }} oifname "{{ outbound_interface }}" counter masquerade
{% endif %}
{% endif %}
  }
}
