#!/bin/sh
# Installed by korserver (UpstreamService). openconnect calls this script on
# every upstream tunnel event. ALL egress via the tunnel is controlled by
# korserver's own fwmark policy routing and nftables rules (routing.mode is
# always full or split), so whatever the upstream server pushes (default
# route, split routes, DNS) must NOT be applied to this namespace's routing
# table or resolv.conf -- with network_mode: host that would hijack the host
# itself. This script only configures the tunnel interface and nothing else.

case "${reason:-}" in
  connect | reconnect)
    ip link set "$TUNDEV" up mtu "${INTERNAL_IP4_MTU:-1400}"
    if [ -n "${INTERNAL_IP4_ADDRESS:-}" ]; then
      ip addr replace "$INTERNAL_IP4_ADDRESS/32" dev "$TUNDEV"
    fi
    if [ -n "${INTERNAL_IP6_ADDRESS:-}" ]; then
      ip -6 addr replace "$INTERNAL_IP6_ADDRESS/128" dev "$TUNDEV" || true
    fi
    ;;
  disconnect)
    ip link set "$TUNDEV" down 2>/dev/null || true
    ;;
esac
exit 0
