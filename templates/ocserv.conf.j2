# Generated by korserver. Manual edits may be overwritten.
tcp-port = {{ config.server.port }}
{% if config.server.udp_enabled %}
udp-port = {{ config.server.port }}
{% endif %}
listen-host = {{ config.server.listen }}
device = {{ config.server.device }}
run-as-user = nobody
run-as-group = nogroup
use-occtl = true
occtl-socket-file = {{ occtl_socket_file }}
socket-file = {{ socket_file }}
{% if config.server.debug_level > 0 %}
log-level = {{ config.server.debug_level }}
{% endif %}

server-cert = {{ server_cert }}
server-key = {{ server_key }}
ca-cert = {{ ca_cert }}
{% if config.auth.certificate.enabled %}
cert-user-oid = 2.5.4.3
{% endif %}

{% for item in auth_lines %}
auth = "{{ item }}"
{% endfor %}
{% if config.identity.config_per_user_dir %}
config-per-user = {{ config.identity.config_per_user_dir }}
{% endif %}
config-per-group = {{ config.identity.config_per_group_dir }}
{% if config.identity.default_group_config %}
default-group-config = {{ config.identity.default_group_config }}
{% endif %}
{% for group in select_groups %}
select-group = {{ group }}
{% endfor %}
select-group-by-url = {{ "true" if config.identity.select_group_by_url else "false" }}
{% if config.identity.default_select_group %}
default-select-group = {{ config.identity.default_select_group }}
{% endif %}

# UI/API realm label: {{ config.server.realm }}
max-clients = {{ config.server.max_clients }}
max-same-clients = {{ config.server.max_same_clients }}
keepalive = {{ config.server.keepalive }}
compression = {{ "true" if config.server.compression else "false" }}
cisco-client-compat = {{ "true" if config.server.cisco_client_compat else "false" }}
try-mtu-discovery = true
isolate-workers = true

ipv4-network = {{ config.server.ipv4_network }}
{% for dns in client_dns %}
dns = {{ dns }}
{% endfor %}
{% if dns_tunnel_active %}
tunnel-all-dns = true
{% endif %}
{% for domain in config.server.search_domains %}
split-dns = {{ domain }}
{% endfor %}
{% if config.server.search_domains %}
default-domain = {{ config.server.search_domains[0] }}
{% endif %}
{% for route in config.server.routes %}
route = {{ route }}
{% endfor %}
{% for route in config.server.no_routes %}
no-route = {{ route }}
{% endfor %}

{% if config.server.connect_script %}
connect-script = {{ config.server.connect_script }}
{% endif %}
{% if config.server.disconnect_script %}
disconnect-script = {{ config.server.disconnect_script }}
{% endif %}

{% if config.server.camouflage.enabled %}
camouflage = true
camouflage_secret = {{ config.server.camouflage.secret }}
camouflage_realm = {{ config.server.camouflage.realm }}
{% endif %}

{% if config.advanced.raw_ocserv_options is mapping %}
{% for key, value in config.advanced.raw_ocserv_options.items() %}
{{ key }}{% if value is not none %} = {{ value }}{% endif %}
{% endfor %}
{% else %}
{% for line in config.advanced.raw_ocserv_options %}
{{ line }}
{% endfor %}
{% endif %}
