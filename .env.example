# korserver env override examples
KORSERVER_CONFIG=/etc/korserver/config.yaml
KORSERVER_SYSTEM__LOG_LEVEL=info
KORSERVER_SERVER__PORT=443
KORSERVER_WEB__ENABLED=false
KORSERVER_WEB__LISTEN=127.0.0.1
KORSERVER_WEB__PORT=8443
KORSERVER_WEB__TLS=true
KORSERVER_WEB__ALLOW_INSECURE_HTTP=false
# Required when KORSERVER_WEB__ENABLED=true unless compose.web.yaml injects it.
# KORSERVER_WEB__ADMIN_PASSWORD=change-me
# Production alternative:
# KORSERVER_WEB__ADMIN_PASSWORD_HASH='scrypt$...'

# For local host access to the optional Web UI, use compose.web.yaml.
# For a TLS-terminating reverse proxy, set KORSERVER_WEB__TLS=false and
# KORSERVER_WEB__ALLOW_INSECURE_HTTP=true, configure trusted proxy IP/CIDR, and
# do not expose port 8443 publicly.
# KORSERVER_WEB__TRUSTED_PROXIES='["127.0.0.1"]'

# Secrets referenced by config.yaml via ${SECRET:NAME}
KORSERVER_ADMIN_PASSWORD=change-me
# KORSERVER_ADMIN_PASSWORD_HASH='scrypt$...'
OIDC_CLIENT_SECRET=change-me
PRIVATE_MAIN_P12_PASSWORD=change-me
PRIVATE_BACKUP_PASSWORD=change-me

# Lists are JSON.
# KORSERVER_SERVER__DNS='["1.1.1.1", "8.8.8.8"]'
