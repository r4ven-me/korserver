# OCPANEL env override examples

OCPANEL_CONFIG=/etc/ocpanel/config.yaml
OCPANEL_SYSTEM__LOG_LEVEL=info
OCPANEL_SERVER__PORT=443
OCPANEL_WEB__ENABLED=false
OCPANEL_WEB__LISTEN=127.0.0.1
OCPANEL_WEB__PORT=8443

# Secrets referenced by config.yaml via ${SECRET:NAME}
OCPANEL_ADMIN_PASSWORD=change-me
PRIVATE_MAIN_P12_PASSWORD=change-me
PRIVATE_BACKUP_PASSWORD=change-me

# Example list override as JSON
# OCPANEL_SERVER__DNS='["1.1.1.1", "8.8.8.8"]'
